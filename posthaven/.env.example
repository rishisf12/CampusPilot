# PostHaven environment (copy to .env and fill in)

# Backend
APP_NAME=PostHaven
APP_VERSION=0.1.0
ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/posthaven
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/posthaven
REDIS_URL=redis://redis:6379/0
SECRET_KEY=dev-secret-change-me
ENCRYPTION_KEY=dev-encryption-key-32bytes!!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_PRIVATE_MAIL_HOSTS=true
SYNC_HEADERS_LIMIT=200
FRONTEND_ORIGIN=http://localhost:5173

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
GREENMAIL_API_PORT=8080
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
GREENMAIL_POP3_PORT=3110

# GreenMail
GREENMAIL_HOST=mailserver
GREENMAIL_DISABLE_SSL_TEST_NAME=true

# Worker
WORKER_CONCURRENCY=4

# AI (P2 — off unless set)
AI_PROVIDER=
