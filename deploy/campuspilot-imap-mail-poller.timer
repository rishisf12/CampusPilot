# Systemd timer for the mail app IMAP poller
# Runs every 5 minutes
# Install: sudo cp deploy/campuspilot-imap-mail-poller.timer /etc/systemd/system/
# Enable: sudo systemctl enable --now campuspilot-imap-mail-poller.timer

[Unit]
Description=Run IMAP mail poller every 5 minutes
Requires=campuspilot-imap-mail-poller.service

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
