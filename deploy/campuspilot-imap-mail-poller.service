# Systemd service for the mail app IMAP poller
# Install: sudo cp deploy/campuspilot-imap-mail-poller.service /etc/systemd/system/

[Unit]
Description=CampusPilot IMAP Mail Poller
After=network.target campuspilot-backend.service
Requires=campuspilot-backend.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/campuspilot
EnvironmentFile=/opt/campuspilot/.env
ExecStart=/opt/campuspilot/.venv/bin/python scripts/ops/imap_mail_poller.py
StandardOutput=journal
StandardError=journal
