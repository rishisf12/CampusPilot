# Systemd service for CampusPilot backend
# Install: sudo cp deploy/campuspilot-backend.service /etc/systemd/system/
# Enable: sudo systemctl enable --now campuspilot-backend

[Unit]
Description=CampusPilot FastAPI Backend
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/campuspilot/backend/backend
EnvironmentFile=/opt/campuspilot/.env
ExecStart=/opt/campuspilot/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/campuspilot/database /opt/campuspilot/backend/backend/uploads

[Install]
WantedBy=multi-user.target