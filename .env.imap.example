# IMAP Poller Environment Variables
# Source this file before running tools/imap_feedback_poller.py
# Or add to your systemd EnvironmentFile

# IMAP connection
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-gmail-app-password
IMAP_FOLDER=INBOX

# Ingest endpoint (your backend)
INGEST_URL=http://localhost:8001/feedback/ingest
# Optional: shared secret if you add auth to the ingest endpoint
INGEST_SECRET=

# Gmail label to mark processed messages
PROCESSED_LABEL=Processed/Feedback