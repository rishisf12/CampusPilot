# CampusPilot — Environment Variables Template
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# All values are strings unless noted otherwise.

# =============================================================================
# REQUIRED FOR PRODUCTION — MUST BE SET
# =============================================================================

# JWT signing key — MUST be ≥ 32 bytes for HS256 (RFC 7518).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database URL — Use postgresql+psycopg driver (not bare postgresql://)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+psycopg://campuspilot:campuspilot@localhost:5432/campuspilot

# SMTP credentials for email verification, password reset, feedback
# Gmail requires an App Password (not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@iiitdmj.ac.in

# =============================================================================
# MONITORING / TELEMETRY — REQUIRED IF ENABLED
# =============================================================================

# HMAC pepper for pseudonymising user_ids in monitoring tables.
# MUST be set in any deployment with telemetry enabled.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The default is ONLY for local development / tests.
TELEMETRY_PEPPER=dev-only-telemetry-pepper

# Enable unauthenticated telemetry ingestion endpoints (/collect/*).
# Off by default — open ingestion is a write path anyone can find.
# Set to "true" to enable.
TELEMETRY_ENABLED=false

# Maximum events per batch the collector accepts (rate limiting)
TELEMETRY_MAX_BATCH=100

# Enable Prometheus /metrics endpoint (route templates, no PII)
METRICS_ENABLED=true

# Run hourly rollup inside the API process (single-VPS convenience).
# Off by default — set on EXACTLY ONE process/replica, or use the rollup worker.
ROLLUP_INLINE=false

# Enable AI-driven scan subsystem (requires local model server / Ollama)
SCAN_ENABLED=false

# Verify Google Play Store receipts (needs Play Developer API credentials)
ENABLE_STORE_VERIFY=false

# =============================================================================
# ALERTING — SET IF YOU WANT TELEGRAM/WEBHOOK/EMAIL ALERTS
# =============================================================================

# Telegram bot token (from @BotFather)
ALERT_TELEGRAM_BOT_TOKEN=

# Telegram chat ID (where alerts are sent)
ALERT_TELEGRAM_CHAT_ID=

# Generic webhook URL for alerts (e.g., Discord, Slack, PagerDuty)
ALERT_WEBHOOK_URL=

# =============================================================================
# LLM / OLLAMA — SET IF SCAN_ENABLED=true
# =============================================================================

# Ollama base URL (internal Docker network if using compose)
OLLAMA_BASE_URL=http://ollama:11434/v1

# Model to use for scans (must be pulled in Ollama)
# Recommended: qwen3:8b (balanced) or qwen3:4b (lite profile)
OLLAMA_MODEL=qwen3:8b

# Request timeout in seconds (scans can take a while)
OLLAMA_TIMEOUT=240

# =============================================================================
# OPTIONAL — HAVE SENSIBLE DEFAULTS
# =============================================================================

# JWT algorithm (keep HS256 unless you rotate to RS256)
ALGORITHM=HS256

# Access token lifetime in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_SSLMODE=prefer

# Email domain allowed for signup (students only)
ALLOWED_EMAIL_DOMAIN=@iiitdmj.ac.in

# Frontend URL for CORS (dev: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Timezone for schedule/attendance calculations
TIMEZONE=Asia/Kolkata

# College hours (24-hour format)
COLLEGE_START=09:00
COLLEGE_END=17:00

# Lunch window (vacant rooms treats this as unavailable)
LUNCH_START=13:00
LUNCH_END=14:00

# Attendance thresholds (percent)
ATTENDANCE_SAFE=75
ATTENDANCE_WARNING=65

# Upload limits
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.pdf,.csv

# Branch list (comma-separated, exact values used in profile dropdown)
BRANCH_OPTIONS=CSE A,CSE B,DS,ECE,ME,SM,PG,MDes

# Programme -> semester count (drives semester dropdown)
PROGRAMME_SEMESTERS=BTech:8,BDes:8,MTech:4,MDes:4,PhD:2

# Admission year for roll-number → semester inference (e.g., 21 = 2021 batch)
ADMISSION_YEAR=21

# Passkeys / WebAuthn
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=essential - Your Campus Assistant
PASSKEY_ORIGINS=http://localhost:5173

# Team-finding: bonus points when viewer shares team owner's branch
BRANCH_MATCH_BONUS=15.0

# =============================================================================
# HACKATHON FEED (EMAIL IMAP INGESTION) — OPTIONAL
# =============================================================================

# IMAP server (Gmail shown; adjust for other providers)
FEED_IMAP_HOST=imap.gmail.com
FEED_IMAP_PORT=993

# IMAP username (email address)
FEED_IMAP_USER=

# Gmail App Password (16 chars), NOT account password
FEED_IMAP_PASSWORD=

# Mailbox to poll
FEED_MAILBOX=INBOX

# Retention: days after which feed entries + attachments are deleted
FEED_RETENTION_DAYS=30

# Media directory for feed attachments (inside container)
FEED_MEDIA_DIR=/app/backend/uploads/feed_media

# Attachment limits
FEED_MAX_ATTACHMENTS=5
FEED_MAX_ATTACHMENT_BYTES=5242880   # 5 MB
FEED_MAX_BODY_CHARS=8000

# =============================================================================
# DOCKER COMPOSE — POSTGRES DEFAULTS (override in .env if needed)
# =============================================================================

POSTGRES_USER=campuspilot
POSTGRES_PASSWORD=campuspilot
POSTGRES_DB=campuspilot

# =============================================================================
# GRAFANA (full profile only)
# =============================================================================

GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# NOTES
# =============================================================================
#
# 1. TELEMETRY_PEPPER: If you enable TELEMETRY_ENABLED=true without setting
#    this, the app will REFUSE to start with a clear error. The default is
#    ONLY for pytest / local dev.
#
# 2. ROLLUP_INLINE: If you run multiple backend replicas, set this on exactly
#    ONE, or disable it everywhere and run the rollup worker service instead
#    (profile "rollup" in docker-compose.yml).
#
# 3. DATABASE_URL: Must use "postgresql+psycopg" driver. A bare "postgresql://"
#    resolves to psycopg2 which is NOT installed.
#
# 4. SMTP_PASSWORD: For Gmail, create an App Password at
#    https://myaccount.google.com/apppasswords (2FA required).
#
# 5. ALERT_TELEGRAM_BOT_TOKEN: Create a bot with @BotFather, then get the
#    chat ID by messaging the bot and visiting:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#
# 6. For production, use a .env file with restrictive permissions (600).
#    Never commit .env to git.
#
# 7. The backend reads .env from the project root (3 levels up from
#    backend/backend/core/config.py). Docker compose reads .env from the
#    compose file directory automatically.