# Copy to .env at the repository root and fill in. Never commit the real thing.
#
#   cp .env.example .env
#
# Everything here has a working default except the secrets, so an unconfigured
# checkout still boots in development. It will NOT boot safely in production -
# SECRET_KEY and POSTGRES_PASSWORD must both be changed.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------
# At least 32 bytes. Rotating it invalidates every issued JWT, logging everyone
# out. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-in-production-min-32-chars

# ---------------------------------------------------------------------------
# Database - PostgreSQL 16
# ---------------------------------------------------------------------------
# When running under docker compose these are usually left unset: the compose
# file builds DATABASE_URL from them and points at the `postgres` service.
# Set them to override the compose defaults.
POSTGRES_USER=campuspilot
POSTGRES_PASSWORD=campuspilot
POSTGRES_DB=campuspilot

# Set this only when running the backend directly on the host (no compose).
# Must be postgresql+psycopg, NOT bare postgresql:// - that resolves to
# psycopg2, which is not installed.
# DATABASE_URL=postgresql+psycopg://campuspilot:campuspilot@localhost:5432/campuspilot

# Connection pool. Sized for a 2-4 GB VPS: 10 persistent connections is ample at
# campus scale, and lower is better than exhausting Postgres' default
# max_connections=100. Ignored when DATABASE_URL points at a SQLite file.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# Recycle before a NAT or firewall can silently drop an idle connection.
# 1800s sits under the usual 3600s cap.
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=10
# prefer | require | disable. Use require for anything off-host.
# DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Email (Gmail SMTP)
# ---------------------------------------------------------------------------
# Uses an App Password, not the account password. Blank values disable sending
# rather than failing at import, so the rest of the app is unaffected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@iiitdmj.ac.in

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=@iiitdmj.ac.in

# ---------------------------------------------------------------------------
# Hackathon feed by email (Gmail IMAP). Blank disables ingestion.
# ---------------------------------------------------------------------------
FEED_IMAP_HOST=imap.gmail.com
FEED_IMAP_PORT=993
FEED_IMAP_USER=
FEED_IMAP_PASSWORD=
FEED_MAILBOX=INBOX
FEED_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Monitoring and AI scans
# ---------------------------------------------------------------------------
# Everything in this block is optional and OFF by default. The dashboards render
# honestly when they are off ("no data yet") rather than showing zeros, so an
# unconfigured deployment is not misleading - it is just empty.

# HMAC pepper for pseudonymising user ids in the monitoring tables.
#
# REQUIRED if you turn on TELEMETRY_ENABLED. The API refuses to accept telemetry
# with the built-in default, because a known pepper means every user_hash in the
# database is reversible: user ids are sequential integers here, so anyone
# holding the table could try id=1, 2, 3... and recover every mapping.
#
# Rotating it pseudonymises all monitoring history at once, which doubles as an
# erasure mechanism.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# TELEMETRY_PEPPER=

# Accept events from the web beacon and the Android SDK.
#
# /collect/events is an unauthenticated write endpoint - a browser beacon and a
# crashing Android process cannot present a session - so it stays off until a
# client is actually sending to it. It is defended by an event-name allowlist, a
# batch size cap, and per-source rate limiting.
# TELEMETRY_ENABLED=false

# Events accepted per request. Lower is safer; 100 is well above what any real
# client needs and far below "enough to be a denial of service".
# TELEMETRY_MAX_BATCH=100

# Serve /metrics for Prometheus. Safe to leave on: it carries route templates
# and status classes, no user identifiers. Should not be reachable from the
# internet without a proxy in front of it.
# METRICS_ENABLED=true

# Run the hourly rollup inside the API process. Convenient for a single replica.
#
# Set this on EXACTLY ONE process. With two or more backends, two timers rebuild
# the same buckets concurrently, and the intermediate state where the rollup is
# empty is visible to a dashboard - which trains admins to ignore flapping. For
# multiple replicas, leave this off and run:
#   docker compose --profile rollup up -d
# ROLLUP_INLINE=true

# Rebuild the rollup by hand at any time, without waiting for the timer:
#   docker compose exec backend python -m features.monitoring.rollup --hours 48 --prune

# AI scan subsystem. Requires a local model server; see
# docs/observability/ARCHITECTURE.md. Off by default so an installation without a
# model does not fill its dashboard with ERROR verdicts.
# SCAN_ENABLED=false

# Verify Play Store receipts. Needs Google Play Developer API credentials. Until
# it is on, every purchase is recorded as unverified and the dashboards say so -
# an unverified total is a claim, not revenue.
# ENABLE_STORE_VERIFY=false