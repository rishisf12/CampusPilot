# CampusPilot / Essential — Environment Variables
# Copy to backend/backend/.env and fill in the secrets marked CHANGE ME.
# Every value below is also the built-in default, so the app boots without a
# .env file — but you MUST set SECRET_KEY and the SMTP values in production.

# ---------------------------------------------------------------------------
# Security / auth
# ---------------------------------------------------------------------------
# JWT signing key. Must be at least 32 bytes for HS256 (RFC 7518).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Only this domain may register an account.
ALLOWED_EMAIL_DOMAIN=@iiitdmj.ac.in

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///../../database/classpilot.db

# ---------------------------------------------------------------------------
# Email (verification codes)
# ---------------------------------------------------------------------------
# Gmail needs an App Password, not your account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@iiitdmj.ac.in

# CORS origin for the dev server.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Timezone and college hours
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
COLLEGE_START=09:00
COLLEGE_END=17:00
LUNCH_START=13:00
LUNCH_END=14:00

# ---------------------------------------------------------------------------
# Attendance thresholds (percentage)
# ---------------------------------------------------------------------------
ATTENDANCE_SAFE=75
ATTENDANCE_WARNING=65

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.pdf,.csv

# ---------------------------------------------------------------------------
# Domain data
# ---------------------------------------------------------------------------
# Canonical branch list used by the profile dropdowns and exam filters.
BRANCH_OPTIONS=CSE A,CSE B,DS,ECE,ME,SM,PG,MDes
# Programme -> number of semesters (drives the semester dropdown).
PROGRAMME_SEMESTERS=BTech:8,BDes:8,MTech:4,MDes:4,PhD:2
# Admission cohort anchor used to infer a semester from a roll-number prefix.
ADMISSION_YEAR=21