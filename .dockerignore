# CampusPilot — Docker ignore file
# Excludes files that should not be copied into Docker images

# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend build output
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files (secrets)
.env
.env.*
!.env.example

# The v1 scan-agent tooling (opencode config + its shell MCP server).
# It must never reach an image: a shell server in a production image is a
# terminal with the app's environment. Phase 10 removes it from the repo.
.opencode/

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Backend uploads (runtime data)
#
# The path is `backend/app/uploads` - the one that exists. The old
# `backend/backend/uploads` matched nothing, so every uploaded timetable and
# exam index on a developer machine was copied into the build context and
# into the image: 2351 files, 15 MB, and a student's uploaded document in a
# production image.
backend/app/uploads/
backend/backend/uploads/
backend/app/uploads
backend/backend/uploads

# Test artifacts
*.cover
.coverage.*

# CI/CD
.github/workflows/*.yml.bak

# Misc
*.bak
*.tmp
*.temp