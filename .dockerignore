# CampusPilot — Docker ignore file
# Excludes files that should not be copied into Docker images

# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend build output
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files (secrets)
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Backend uploads (runtime data)
backend/backend/uploads/

# Test artifacts
*.cover
.coverage.*

# CI/CD
.github/workflows/*.yml.bak

# Misc
*.bak
*.tmp
*.temp